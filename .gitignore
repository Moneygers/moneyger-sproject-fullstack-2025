# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ---- Global ignores ----
.DS_Store
*.log

# ---- Python/Django (backend) ----
backend/__pycache__/
backend/**/*.py[cod]
backend/env/
backend/venv/
backend/.env
backend/db.sqlite3

# ---- Node/Frontend ----
frontend/node_modules/
frontend/build/
frontend/.env*
frontend/.pnp
frontend/pnp.js
frontend/coverage

# ---- Editor & OS files ----
.vscode/
.idea/
*.swp
